---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-primary-900 via-primary-800 to-primary-600">
    <!-- Pattern overlay -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    <!-- Glow -->
    <div class="hidden sm:block absolute top-1/4 -left-32 w-96 h-96 bg-primary-400/20 rounded-full blur-3xl"></div>
    <div class="hidden sm:block absolute bottom-1/4 -right-32 w-96 h-96 bg-primary-500/20 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16 sm:pt-32 sm:pb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Text -->
        <div class="text-center lg:text-left">
<h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            Vos états des lieux,
            <span class="text-primary-200 [text-shadow:0_0_30px_rgba(165,180,252,0.6)]">simplifiés.</span>
          </h1>
          <p class="text-lg sm:text-xl text-white/70 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0">
            Créez, signez et partagez vos états des lieux en quelques minutes. Photos, signatures électroniques, analyse IA — tout depuis votre téléphone.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="#tarifs" class="bg-white text-primary-700 px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-primary-50 transition-all shadow-lg shadow-primary-900/30 hover:shadow-xl hover:-translate-y-0.5">
              Découvrir nos offres
            </a>
            <a href="#fonctionnalités" class="border border-white/30 text-white px-8 py-3.5 rounded-xl text-base font-semibold hover:bg-white/10 transition-all">
              Voir les fonctionnalités
            </a>
          </div>
        </div>

        <!-- Screenshots mockup -->
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <!-- Phone frame principal -->
            <div class="relative z-10 w-56 sm:w-64 rounded-3xl overflow-hidden shadow-2xl shadow-black/40 ring-1 ring-white/20">
              <img src="/images/IMG_4672.PNG" alt="Tableau de bord Edlya" class="w-full" />
            </div>
            <!-- Phone frame secondaire -->
            <div class="hidden sm:block absolute -right-16 top-12 w-56 rounded-3xl overflow-hidden shadow-2xl shadow-black/40 ring-1 ring-white/10 -rotate-3">
              <img src="/images/IMG_4676.PNG" alt="Analyse IA Edlya" class="w-full" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave separator -->
    <div class="absolute -bottom-px left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full block">
        <path d="M0 40L48 36C96 32 192 24 288 28C384 32 480 48 576 52C672 56 768 48 864 40C960 32 1056 24 1152 28C1248 32 1344 48 1392 56L1440 64V80H0V40Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- POURQUOI EDLYA -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Pourquoi choisir Edlya ?</h2>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">Une application pensée pour les professionnels de l'immobilier qui veulent gagner du temps et rester professionnels.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        <!-- Card 1 -->
        <div class="group bg-slate-50 hover:bg-primary-50 rounded-2xl p-6 sm:p-8 transition-all hover:shadow-lg hover:-translate-y-1">
          <div class="w-12 h-12 bg-primary-100 group-hover:bg-primary-200 rounded-xl flex items-center justify-center mb-5 transition-colors">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Gain de temps</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Réalisez un état des lieux complet en quelques minutes au lieu de plusieurs heures.</p>
        </div>

        <!-- Card 2 -->
        <div class="group bg-slate-50 hover:bg-primary-50 rounded-2xl p-6 sm:p-8 transition-all hover:shadow-lg hover:-translate-y-1">
          <div class="w-12 h-12 bg-primary-100 group-hover:bg-primary-200 rounded-xl flex items-center justify-center mb-5 transition-colors">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Valeur juridique</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Signatures électroniques, photos géolocalisées et horodatées pour une valeur probante.</p>
        </div>

        <!-- Card 3 -->
        <div class="group bg-slate-50 hover:bg-primary-50 rounded-2xl p-6 sm:p-8 transition-all hover:shadow-lg hover:-translate-y-1">
          <div class="w-12 h-12 bg-primary-100 group-hover:bg-primary-200 rounded-xl flex items-center justify-center mb-5 transition-colors">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Intelligence artificielle</h3>
          <p class="text-slate-500 text-sm leading-relaxed">L'IA détecte automatiquement les dégradations et estime les coûts de réparation.</p>
        </div>

        <!-- Card 4 -->
        <div class="group bg-slate-50 hover:bg-primary-50 rounded-2xl p-6 sm:p-8 transition-all hover:shadow-lg hover:-translate-y-1">
          <div class="w-12 h-12 bg-primary-100 group-hover:bg-primary-200 rounded-xl flex items-center justify-center mb-5 transition-colors">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">100% mobile</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Travaillez depuis votre téléphone, même sans connexion internet. Tout se synchronise après.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FONCTIONNALITES -->
  <section id="fonctionnalités" class="py-16 sm:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Tout ce dont vous avez besoin</h2>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">Des fonctionnalités pensées pour couvrir chaque étape de vos états des lieux.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {[
          { icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6", title: "Gestion des logements", desc: "Centralisez tous vos biens avec leurs informations et historique d'états des lieux." },
          { icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01", title: "EDL complets", desc: "Entrée ou sortie, pièce par pièce, élément par élément. Rien n'est oublié." },
          { icon: "M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z M15 13a3 3 0 11-6 0 3 3 0 016 0z", title: "Photos géolocalisées", desc: "Chaque photo est horodatée et géolocalisée pour une preuve irréfutable." },
          { icon: "M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z", title: "Signatures électroniques", desc: "Bailleur et locataire signent directement sur le téléphone. Valeur juridique assurée." },
          { icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z", title: "Analyse IA", desc: "Détection automatique des dégradations avec estimation des coûts de réparation." },
          { icon: "M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10", title: "Export PDF", desc: "Générez des rapports PDF professionnels en un clic, prêts à être partagés." },
          { icon: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4", title: "Comparatif entrée/sortie", desc: "Comparez automatiquement l'état d'entrée et de sortie pour identifier les écarts." },
          { icon: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12", title: "Import PDF", desc: "Importez vos anciens états des lieux au format PDF pour les centraliser." },
          { icon: "M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414 1 1 0 01-1.414-1.414z", title: "Mode hors-ligne", desc: "Travaillez sans connexion. Tout se synchronise automatiquement dès que vous êtes connecté." },
        ].map(feature => (
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-shadow border border-slate-100">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon} />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-slate-900 mb-2">{feature.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMMENT CA MARCHE -->
  <section id="comment-ca-marche" class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Comment ça marche ?</h2>
        <p class="text-lg text-slate-500 max-w-2xl mx-auto">Trois étapes suffisent pour réaliser un état des lieux professionnel.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 sm:gap-12">
        <!-- Step 1 -->
        <div class="text-center">
          <div class="relative w-48 sm:w-52 mx-auto mb-8 rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-200">
            <img src="/images/IMG_4673.PNG" alt="Gestion des logements" class="w-full" />
          </div>
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary-600 text-white font-bold text-sm mb-4">1</div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Ajoutez vos logements</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Renseignez vos biens une seule fois. Ils sont prêts pour tous vos futurs états des lieux.</p>
        </div>

        <!-- Step 2 -->
        <div class="text-center">
          <div class="relative w-48 sm:w-52 mx-auto mb-8 rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-200">
            <img src="/images/IMG_4674.PNG" alt="Realisation de l'EDL" class="w-full" />
          </div>
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary-600 text-white font-bold text-sm mb-4">2</div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Inspectez et documentez</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Parcourez chaque pièce, prenez des photos, notez l'état. L'IA vous assiste en temps réel.</p>
        </div>

        <!-- Step 3 -->
        <div class="text-center">
          <div class="relative w-48 sm:w-52 mx-auto mb-8 rounded-2xl overflow-hidden shadow-xl ring-1 ring-slate-200">
            <img src="/images/IMG_4675.PNG" alt="Signature électronique" class="w-full" />
          </div>
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary-600 text-white font-bold text-sm mb-4">3</div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">Signez et partagez</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Signatures électroniques sur place, export PDF instantané. C'est terminé.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TARIFS -->
  <section id="tarifs" class="py-16 sm:py-24 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-700 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 sm:mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Des tarifs simples et transparents</h2>
        <p class="text-lg text-white/60 max-w-2xl mx-auto">Choisissez la formule qui correspond à votre activité.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 sm:gap-8 max-w-4xl mx-auto">
        <!-- À l'unité -->
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-6 sm:p-8 hover:bg-white/15 transition-all flex flex-col justify-between">
          <div>
            <h3 class="text-xl font-semibold text-white mb-2">À l'unité</h3>
            <p class="text-white/60 text-sm mb-6">Idéal pour les particuliers ou besoins ponctuels.</p>
            <div class="mb-6">
              <span class="text-3xl sm:text-5xl font-bold text-white">14,40</span>
              <span class="text-xl text-white/80 ml-1">EUR TTC</span>
              <p class="text-white/50 text-sm mt-1">12 EUR HT par état des lieux</p>
            </div>
            <ul class="space-y-3">
              {["EDL complet (entrée ou sortie)", "Photos géolocalisées", "Signatures électroniques", "Export PDF professionnel", "Analyse IA des dégradations"].map(item => (
                <li class="flex items-start gap-3 text-white/80 text-sm">
                  <svg class="w-5 h-5 text-green-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <a href="#contact" class="block text-center border border-white/30 text-white px-6 py-3 rounded-xl font-semibold hover:bg-white/10 transition-all mt-8">
            Demander un devis
          </a>
        </div>

        <!-- Abonnement -->
        <div class="relative bg-white rounded-2xl p-6 sm:p-8 shadow-2xl shadow-primary-900/30 flex flex-col justify-between border border-slate-200">
          <div>
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gradient-to-r from-primary-500 to-primary-600 text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider">
              Recommandé
            </div>
            <h3 class="text-xl font-semibold text-slate-900 mb-2">Abonnement</h3>
            <p class="text-slate-500 text-sm mb-6">Pour les professionnels qui gèrent plusieurs biens.</p>
            <div class="mb-6">
              <span class="text-3xl sm:text-5xl font-bold text-slate-900">49,99</span>
              <span class="text-xl text-slate-500 ml-1">EUR/mois</span>
              <p class="text-slate-400 text-sm mt-1">Etats des lieux illimités</p>
            </div>
            <ul class="space-y-3">
              {["EDL illimités (entrée et sortie)", "Toutes les fonctionnalités incluses", "Comparatif entrée/sortie automatique", "Import de vos anciens EDL (PDF)", "Mode hors-ligne"].map(item => (
                <li class="flex items-start gap-3 text-slate-600 text-sm">
                  <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <a href="#contact" class="block text-center bg-gradient-to-r from-primary-600 to-primary-700 text-white px-6 py-3 rounded-xl font-semibold hover:from-primary-700 hover:to-primary-800 transition-all mt-8">
            Souscrire maintenant
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Info -->
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Une question ? Contactez-nous</h2>
          <p class="text-lg text-slate-500 mb-8 leading-relaxed">
            Vous souhaitez en savoir plus sur Edlya ou demander votre code d'activation ? Notre équipe vous répond sous 24h.
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-slate-900">Email</p>
                <a href="mailto:contact@edlya.fr" class="text-primary-600 hover:text-primary-700">contact@edlya.fr</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-slate-900">Adresse</p>
                <p class="text-slate-500">30 rue Joseph Bonnet, 33100 Bordeaux</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-100">
          <form id="contact-form" class="space-y-5">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">Nom complet</label>
                <input type="text" id="name" name="name" required
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all text-sm" placeholder="Jean Dupont" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">Email</label>
                <input type="email" id="email" name="email" required
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all text-sm" placeholder="jean@exemple.fr" />
              </div>
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700 mb-1.5">Téléphone</label>
              <input type="tel" id="phone" name="phone"
