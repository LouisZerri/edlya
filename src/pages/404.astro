---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page introuvable — Edlya">
  <Header solid />

  <div class="h-16 sm:h-20"></div>
  <section class="py-24 sm:py-32 bg-white min-h-[60vh] flex items-center">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-7xl sm:text-9xl font-bold text-primary-600 mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">Page introuvable</h1>
      <p class="text-slate-500 mb-8">La page que vous recherchez n'existe pas ou a été déplacée.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-primary-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-700 transition-all cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Retour à l'accueil
      </a>
    </div>
  </section>

  <Footer />
</Layout>
